# Quickstart defaults for docker compose
# Usage:
#   cp default.env .env
#   docker compose up --build
#
# Do not set PATH in .env for docker compose — it is injected into the core container
# and will hide /usr/local/bin/agent-core. Configure host-only tools in host-bridge.env.

LISTEN_ADDR=0.0.0.0:8090
# Canonical WorkNet HTTPS URL (also editable in Admin → Network access)
CORE_URL=https://omni.worknet
# Exact host deployment identity consumed by update.sh; leave context blank to use the active Docker context.
DOCKER_CONTEXT=
COMPOSE_PROJECT_NAME=omnidex
WRAPPER_ONLY=false

# Core uses bundled postgres service from docker-compose.yml
DATABASE_URL=postgres://agent:agent@postgres:5432/agent?sslmode=disable
DATABASE_SCHEMA=omnidex_runtime
# Core uses bundled redis service from docker-compose.yml for server-authoritative UI session state.
REDIS_URL=redis://redis:6379/0
UI_REDIS_REQUIRED=false
UI_SESSION_TTL=30m

# Host bridge for native directory picker + host filesystem browse (Docker setups).
# On the host: omni host service install   (systemd user service, starts at login)
# Or manually: omni host serve --listen 0.0.0.0:8091
# Then point core at it:
HOST_AGENT_URL=http://host.docker.internal:8091
# HOST_AGENT_TOKEN=
# Browser terminal defaults to proxying through core (port 8090 only).
# For direct browser→bridge on port 8091 (lower latency, requires firewall open):
# OMNI_TERMINAL_DIRECT=true
# HOST_BRIDGE_PUBLIC_WS_URL=ws://192.168.1.102:8091

# Ollama running on host machine.
# Linux: ensure Ollama listens beyond loopback (OLLAMA_HOST=0.0.0.0:11434).
# Core uses exactly OLLAMA_BASE_URL; it does not probe alternate endpoints.
# host.docker.internal, the docker bridge gateway, then localhost.
# If a manual gateway IP stops working, remove it or set OLLAMA_BASE_URL back to host.docker.internal.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OMNI_CONVERSATION_CONTEXT_SELECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_MEMORY_CONTEXT_SELECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_CONVERSATION_OBJECTIVE_KIND_MODEL=qwen3.5:9b-q4_K_M
OMNI_OBJECTIVE_ADVISORY_MODE=off
OMNI_OBJECTIVE_ADVISORY_MODEL=qwen3.5:9b-q4_K_M
OMNI_CONVERSATION_RESPONSE_MODEL=qwen3.5:9b-q4_K_M
OMNI_GROUNDED_ANSWER_MODEL=qwen3.5:9b-q4_K_M
OMNI_REPOSITORY_EVIDENCE_RELEVANCE_MODEL=qwen3.5:9b-q4_K_M
OMNI_REPOSITORY_GROUNDED_REVIEW_MODEL=deepseek-r1:8b
OMNI_REPOSITORY_GROUNDED_CORRECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_SEARCH_TERMS_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_RELEVANCE_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_GROUNDED_SYNTHESIS_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_GROUNDED_SYNTHESIS_CORRECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_CLAIM_EVIDENCE_REVIEW_MODEL=deepseek-r1:8b
OMNI_CODING_SURFACE_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_REQUIREMENTS_MODEL=llama3.2:3b
OMNI_CODING_WORKLOAD_MODEL=llama3.2:3b
OMNI_CODING_WORKLOAD_REVIEW_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_ARTIFACT_HANDLING_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_CAPABILITY_RELATION_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_SKILL_SELECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_FRAGMENT_MODEL=qwen2.5-coder:7b
OMNI_CODING_FRAGMENT_REPAIR_GUIDANCE_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_FRAGMENT_CORRECTION_MODEL=qwen2.5-coder:7b
OMNI_CODING_REPOSITORY_SEARCH_TERM_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_REPOSITORY_CHANGE_SURFACE_MODEL=qwen3.5:9b-q4_K_M
EMBEDDING_MODEL=nomic-embed-text
INFERENCE_CONTEXT_TOKENS=8192

# Optional OpenAI embedding transport (set EMBEDDING_PROVIDER=openai):
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Google embedding transport (set EMBEDDING_PROVIDER=google):
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Optional Hugging Face embedding transport (set EMBEDDING_PROVIDER=huggingface):
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Optional compatible embedding providers include qwen, zhipu, qianfan,
# hunyuan, baichuan, and siliconflow. Example:
# EMBEDDING_PROVIDER=qwen
# QWEN_API_KEY=
# QWEN_EMBEDDING_MODEL=

# Strict catch-all for another OpenAI-compatible Chinese service:
# EMBEDDING_PROVIDER=compatible
# COMPATIBLE_BASE_URL=
# COMPATIBLE_API_KEY=

# Optional: route embeddings through a different consumed embedding transport.
EMBEDDING_PROVIDER=ollama

WEB_SEARCH_PROVIDERS=duckduckgo,google,reddit
WEB_SEARCH_TIMEOUT=15s
WEB_SEARCH_PER_SOURCE_BUDGET=3000
WEB_SEARCH_TOTAL_BUDGET=6000

WORKSPACE_ROOT=/workspace

WORKER_COUNT=3
CODING_FRAGMENT_CONCURRENCY=1
WORKER_POLL_INTERVAL=2s
REQUEST_TIMEOUT=10m
REALTIME_MAX_CLIENTS=512
REALTIME_STREAM_MAX_AGE=30m
REALTIME_HEARTBEAT=25s
REALTIME_WRITE_TIMEOUT=10s
MIGRATE_ON_STARTUP=true

# Required for Docker: one absolute host project boundary mounted read-write into /workspace.
# Native coding maps client paths into this boundary and rejects every path outside it.
# Example: HOST_WORKSPACE_PATH=/home/you/Projects
HOST_WORKSPACE_PATH=
