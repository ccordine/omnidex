LISTEN_ADDR=0.0.0.0:8090
# Canonical WorkNet HTTPS URL (Admin → Network access can override in DB)
CORE_URL=https://omni.worknet
# Exact bearer secret required by every /v1/integrations/* request. Empty disables the integration API.
OMNIDEX_INTEGRATION_API_TOKEN=
# Delegated authorities use an explicitly paired URL and outbound token.
# OMNIDEX_DELEGATED_AUTHORITY_APPLICATION_URL=https://application.internal
# OMNIDEX_DELEGATED_AUTHORITY_APPLICATION_TOKEN=
# Required exact host deployment identity consumed by update.sh and the Compose wrappers.
# Set this to the intended named context (for example, default or rootless); blank fails loudly.
DOCKER_CONTEXT=
COMPOSE_PROJECT_NAME=omnidex
# Set the exact numeric owner of HOST_WORKSPACE_PATH. Managed Compose builds and
# runs the non-root app identity with these values so host edits retain ownership.
HOST_UID=1000
HOST_GID=1000
# Exact rootless Docker service socket used by code-owned verification.
DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
# Configure an exact reachable topology before asking Omnidex to keep a
# generated service running. Empty values fail loudly for persistent hosting.
OMNIDEX_DEPLOYMENT_BIND_ADDRESS=
OMNIDEX_DEPLOYMENT_ADVERTISED_HOST=
OMNIDEX_DEPLOYMENT_PROBE_HOST=

# Use bundled postgres service:
DATABASE_URL=postgres://agent:agent@postgres:5432/agent?sslmode=disable
DATABASE_SCHEMA=omnidex_runtime
# Use bundled redis service for server-authoritative UI session state:
REDIS_URL=redis://redis:6379/0
UI_REDIS_REQUIRED=false
UI_SESSION_TTL=30m

# Or point at your existing rooms-ai postgres/pgvector instance instead:
# DATABASE_URL=postgres://<user>:<pass>@host.docker.internal:5432/<db>?sslmode=disable
# DATABASE_SCHEMA=omnidex_runtime

LLM_PROVIDER=ollama

# If Ollama runs on your host machine:
# Linux: ensure Ollama listens beyond loopback (OLLAMA_HOST=0.0.0.0:11434)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OMNI_CONTEXT_SEARCH_TERMS_MODEL=qwen3.5:9b-q4_K_M
# Browser WebGPU is opt-in, has no server fallback, and requires a separately
# qualified exact WebLLM model ID. No checked-in browser candidate is qualified yet.
OMNI_CONTEXT_RELEVANCE_PROVIDER=server
OMNI_CONTEXT_RELEVANCE_MODEL=qwen3.5:9b-q4_K_M
OMNI_CONTEXT_MINIFICATION_MODEL=qwen3.5:9b-q4_K_M
OMNI_CONVERSATION_OBJECTIVE_KIND_MODEL=qwen3.5:9b-q4_K_M
OMNI_CONVERSATION_RESPONSE_MODEL=qwen3.5:9b-q4_K_M
OMNI_ROLEPLAY_SEMANTIC_MODEL=qwen3.5:9b-q4_K_M
OMNI_GROUNDED_ANSWER_MODEL=qwen3.5:9b-q4_K_M
OMNI_DATABASE_SCHEMA_SELECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_DATABASE_QUERY_INTENT_MODEL=qwen3.5:9b-q4_K_M
OMNI_DATABASE_EVIDENCE_GAP_MODEL=qwen3.5:9b-q4_K_M
OMNI_DATABASE_JOIN_PATH_SELECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_REPOSITORY_EVIDENCE_RELEVANCE_MODEL=qwen3.5:9b-q4_K_M
OMNI_REPOSITORY_GROUNDED_REVIEW_MODEL=deepseek-r1:8b
OMNI_REPOSITORY_GROUNDED_CORRECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_SEARCH_TERMS_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_RELEVANCE_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_GROUNDED_SYNTHESIS_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_GROUNDED_SYNTHESIS_CORRECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_WEB_CLAIM_EVIDENCE_REVIEW_MODEL=deepseek-r1:8b
OMNI_CODING_SURFACE_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_REQUIREMENTS_MODEL=llama3.2:3b
OMNI_CODING_SERVICE_DEPLOYMENT_INTENT_MODEL=phi4:14b
OMNI_CODING_WORKLOAD_MODEL=llama3.2:3b
OMNI_CODING_ARTIFACT_HANDLING_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_CAPABILITY_RELATION_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_SKILL_SELECTION_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_FRAGMENT_MODEL=qwen2.5-coder:7b
OMNI_CODING_FRAGMENT_REPAIR_GUIDANCE_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_FRAGMENT_CORRECTION_MODEL=qwen2.5-coder:7b
OMNI_CODING_REPOSITORY_SEARCH_TERM_MODEL=qwen3.5:9b-q4_K_M
OMNI_CODING_REPOSITORY_CHANGE_SURFACE_MODEL=qwen3.5:9b-q4_K_M
EMBEDDING_MODEL=nomic-embed-text
INFERENCE_CONTEXT_TOKENS=8192

# Optional OpenAI embedding transport (set EMBEDDING_PROVIDER=openai):
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Azure embedding transport (set EMBEDDING_PROVIDER=azure):
# API styles: v1 for /openai/v1 OpenAI-compatible Azure APIs, azure_openai for deployment routes, foundry for /models endpoints.
AZURE_AI_BASE_URL=
AZURE_OPENAI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_AI_API_VERSION=
AZURE_AI_API_STYLE=
AZURE_AI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Optional Google embedding transport (set EMBEDDING_PROVIDER=google):
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=text-embedding-004

# Optional Hugging Face embedding transport (set EMBEDDING_PROVIDER=huggingface):
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2

# Optional hosted embedding transports. Select one with EMBEDDING_PROVIDER and
# set its exact embedding model and credential.
# Base URLs below are defaults; override them for regional/workspace endpoints.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_EMBEDDING_MODEL=

ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_MODEL=

QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
QIANFAN_API_KEY=
QIANFAN_EMBEDDING_MODEL=

HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
HUNYUAN_API_KEY=
HUNYUAN_EMBEDDING_MODEL=

BAICHUAN_BASE_URL=https://api.baichuan-ai.com/v1
BAICHUAN_API_KEY=
BAICHUAN_EMBEDDING_MODEL=

SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
SILICONFLOW_EMBEDDING_MODEL=

# Strict catch-all for another OpenAI-compatible embedding endpoint.
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
COMPATIBLE_EMBEDDING_MODEL=

# Optional: route embeddings through a different consumed embedding transport.
EMBEDDING_PROVIDER=ollama

WEB_SEARCH_PROVIDERS=brave,google,reddit
WEB_SEARCH_TIMEOUT=15s
WEB_SEARCH_PER_SOURCE_BUDGET=3000
WEB_SEARCH_TOTAL_BUDGET=6000
WORKSPACE_ROOT=/workspace
# Required for Docker: one absolute host project boundary mounted read-write at WORKSPACE_ROOT.
# Native coding rejects any requested project outside this boundary.
HOST_WORKSPACE_PATH=/home/you/Projects
WORKER_COUNT=3
CODING_FRAGMENT_CONCURRENCY=1
WORKER_POLL_INTERVAL=2s
REQUEST_TIMEOUT=10m
REALTIME_MAX_CLIENTS=512
REALTIME_STREAM_MAX_AGE=30m
REALTIME_HEARTBEAT=25s
REALTIME_WRITE_TIMEOUT=10s
MIGRATE_ON_STARTUP=true
