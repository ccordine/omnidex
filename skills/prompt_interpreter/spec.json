{
  "id": "prompt_interpreter",
  "purpose": "Translate the current user message into the sole authoritative typed objective and capability contract for downstream roles.",
  "preferred_model": ["fast"],
  "allowed_tools": [],
  "forbidden_tools": ["workspace.research", "memory.retrieve", "web.search", "evidence.inspect"],
  "context_budget": 8000,
  "input_schema": "input.schema.json",
  "output_schema": "output.schema.json",
  "stop_conditions": ["current objective is explicit", "prior context cannot create objectives", "completion criteria are testable"],
  "retry_policy": "bounded_repair_passes",
  "require_evidence": false
}
